# ============================================================================
#  Dark Studio - variaveis de ambiente
#  Copie este ficheiro para ".env" e preencha o que usar:
#      Windows:  copy .env.example .env
#      Linux:    cp .env.example .env
#
#  NUNCA coloque uma chave real neste ficheiro partilhavel. O ".env" esta no
#  .gitignore e a aplicacao tambem o escreve sozinha em /api/settings.
#  O ficheiro e lido com encoding UTF-8; nao use acentos nas chaves.
#  Validate o resultado com:  python scripts/check_env.py
# ============================================================================

# --- Modelo editorial (obrigatorio para gerar guioes) ------------------------
# Chave de https://openrouter.ai/keys . Sem isto o servidor arranca, mas toda a
# geracao de texto cai no modelo de fallback local.
OPENROUTER_API_KEY=

# Tem de terminar em :free. Nem todos os modelos :free tem endpoints para todas
# as chaves; se /api/ai/test responder 404 "No endpoints found", troque o modelo.
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# --- Stock media (opcional; sem chaves o sistema so usa material local) -------
# https://www.pexels.com/api/   -> PEXELS_API_KEY
PEXELS_API_KEY=
# https://pixabay.com/api/docs/ -> PIXABAY_API_KEY
PIXABAY_API_KEY=

# --- Providers alternativos (opcionais; cada um e ligado por uma chave) ------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://developers.google.com/youtube/v3/getting-started
# (necessaria apenas para analise de metadados do YouTube)
YOUTUBE_API_KEY=

# --- Sintese de voz (opcionais; sem elas usa-se edge-tts, sem chave) --------
# Se as duas estiverem preenchidas, a Azure passa a ser preferida; caso
# contrario o edge-tts (pacote `edge-tts`, sem chave) faz a narracao.
# https://portal.azure.com/ -> "Speech service" -> Chaves e Regiao
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Portas epaths (opcionais; raramente precisa de mexer) -------------------
# Porta base do servidor. start.bat / start.sh procuram a primeira porta livre
# acima desta (8013, 8014, 8015, ...). Pode tambem definir DARK_STUDIO_PORT_MAX
# para limitar a busca.
DARK_STUDIO_PORT=8013
# DARK_STUDIO_PORT_MAX=8023
# Defina DARK_STUDIO_NO_BROWSER=1 para o arranque nao abrir o navegador.
