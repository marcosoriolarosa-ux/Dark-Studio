# OpenRouter / OpenCode-compatible editorial model
# Nunca coloque uma chave real neste ficheiro partilhável.
OPENROUTER_API_KEY=

# Tem de terminar em :free. Nem todos os modelos :free tem endpoints para todas
# as chaves; se /api/ai/test responder 404 "No endpoints found", troque o modelo.
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Stock media opcional
PEXELS_API_KEY=
PIXABAY_API_KEY=